# ==============================================================================
# DevConnect Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Works with local PostgreSQL, Neon.tech, Supabase, Railway, etc.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devconnect?schema=public"

# Authentication & JWT
# Generated random string for HMAC JWT signing
JWT_SECRET="devconnect-ultra-secure-jwt-secret-key-change-in-production-2026"
SESSION_COOKIE_NAME="devconnect_token"

# Optional: Upstash Redis (Caching & Rate Limiting)
# If left empty, DevConnect automatically falls back to an in-memory cache safely without errors.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: GitHub OAuth credentials
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
